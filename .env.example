# --- Mock bridge (offline / UI debugging) ---
NEXT_PUBLIC_USE_MOCK_WS=true

# --- Robot bridge (telemetry, logs, commands) ---
NEXT_PUBLIC_ROBOT_WS_URL=ws://10.42.0.69:8765

# --- RealSense video ---
# RTSP (reference / VLC); browsers use WebRTC (WHEP) below.
NEXT_PUBLIC_REALSENSE_RTSP=rtsp://10.42.0.69:8554/realsense

# MediaMTX WHEP URL (WebRTC in the browser). Default port 8889.
# Set to "off" to disable the camera player.
NEXT_PUBLIC_REALSENSE_WHEP=http://10.42.0.69:8889/realsense/whep
