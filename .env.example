# --- Mock bridge (offline / UI debugging) ---
# Set to true to simulate WebSocket + fake telemetry/logs (no connection to :8765).
NEXT_PUBLIC_USE_MOCK_WS=false

# --- Robot bridge (telemetry, logs, commands) ---
NEXT_PUBLIC_ROBOT_WS_URL=ws://10.42.0.69:8765

# --- RealSense video ---
# RTSP (shown in UI; browsers cannot decode RTSP in <video>).
NEXT_PUBLIC_REALSENSE_RTSP=rtsp://10.42.0.69:8554/realsense

# HLS URL for in-browser playback (MediaMTX default HLS port is often 8888).
# Use NEXT_PUBLIC_REALSENSE_HLS=off to disable <video> and show placeholder only.
NEXT_PUBLIC_REALSENSE_HLS=http://10.42.0.69:8888/realsense/index.m3u8
